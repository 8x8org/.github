{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8x8.org/schemas/8x8-live-state-0.0.1.schema.json",
  "title": "8x8 Live State 0.0.1",
  "type": "object",
  "required": ["product_version","generated_at","reality","agents","leases","missions","services","repositories","deployments","contradictions","evidence"],
  "properties": {
    "product_version": {"const": "0.0.1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "reality": {"enum": ["PRIVATE_PAST","PUBLIC_PRESENT","FUTURE_LAB"]},
    "promotion_state": {"enum": ["NONE","PROTECTED_BETA"]},
    "agents": {"type": "array", "items": {"$ref": "#/$defs/agent"}},
    "leases": {"type": "array", "items": {"$ref": "#/$defs/lease"}},
    "missions": {"type": "array", "items": {"$ref": "#/$defs/mission"}},
    "services": {"type": "array", "items": {"$ref": "#/$defs/service"}},
    "repositories": {"type": "array", "items": {"$ref": "#/$defs/repository"}},
    "deployments": {"type": "array", "items": {"$ref": "#/$defs/deployment"}},
    "contradictions": {"type": "array", "items": {"$ref": "#/$defs/contradiction"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "agent": {"type": "object", "required": ["agent_id","state","last_seen_at"], "properties": {"agent_id":{"type":"string"},"body_id":{"type":"string"},"node_id":{"type":"string"},"state":{"enum":["ACTIVE","IDLE","BLOCKED","STALE","UNKNOWN"]},"task_id":{"type":["string","null"]},"last_seen_at":{"type":"string","format":"date-time"},"evidence_digest":{"$ref":"#/$defs/digest"}}},
    "lease": {"type":"object","required":["lease_id","agent_id","targets","issued_at","expires_at","state"],"properties":{"lease_id":{"type":"string"},"agent_id":{"type":"string"},"targets":{"type":"array","items":{"type":"string"}},"issued_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"state":{"enum":["ACTIVE","EXPIRED","REVOKED","CONFLICT"]},"rollback_ref":{"type":["string","null"]}}},
    "mission": {"type":"object","required":["mission_id","status","reality","evidence_state"],"properties":{"mission_id":{"type":"string"},"status":{"enum":["PENDING","EXECUTING","BLOCKED","FAILED","COMPLETED","SUPERSEDED"]},"reality":{"enum":["PRIVATE_PAST","PUBLIC_PRESENT","FUTURE_LAB"]},"evidence_state":{"enum":["UNKNOWN","REPORTED","IMPLEMENTED","VERIFIED","DEPLOYED","PUBLICLY_RELEASED","STALE"]},"receipt_digest":{"$ref":"#/$defs/digest"}}},
    "service": {"type":"object","required":["service_id","state","observed_at"],"properties":{"service_id":{"type":"string"},"state":{"enum":["RUNNING","STOPPED","DEGRADED","FAILED","UNKNOWN"]},"observed_at":{"type":"string","format":"date-time"},"evidence_digest":{"$ref":"#/$defs/digest"}}},
    "repository": {"type":"object","required":["full_name","head","cleanliness","reality"],"properties":{"full_name":{"type":"string"},"head":{"type":"string"},"branch":{"type":"string"},"cleanliness":{"enum":["CLEAN","DIRTY","UNKNOWN"]},"reality":{"enum":["PRIVATE_PAST","PUBLIC_PRESENT","FUTURE_LAB"]}}},
    "deployment": {"type":"object","required":["deployment_id","state","reality"],"properties":{"deployment_id":{"type":"string"},"state":{"enum":["PLANNED","PREVIEW","READY","FAILED","REVOKED","UNKNOWN"]},"reality":{"enum":["PRIVATE_PAST","PUBLIC_PRESENT","FUTURE_LAB"]},"source_digest":{"$ref":"#/$defs/digest"}}},
    "contradiction": {"type":"object","required":["contradiction_id","claims","state"],"properties":{"contradiction_id":{"type":"string"},"claims":{"type":"array","minItems":2,"items":{"type":"string"}},"state":{"enum":["OPEN","RESOLVING","RESOLVED","SUPERSEDED"]},"safe_assumption":{"type":["string","null"]}}},
    "evidence": {"type":"object","required":["evidence_id","digest","observed_at","fresh_until","truth_state"],"properties":{"evidence_id":{"type":"string"},"digest":{"$ref":"#/$defs/digest"},"observed_at":{"type":"string","format":"date-time"},"fresh_until":{"type":"string","format":"date-time"},"truth_state":{"enum":["OBSERVED","REPORTED","INFERRED","VERIFIED","STALE","REVOKED","SUPERSEDED"]}}}
  }
}
