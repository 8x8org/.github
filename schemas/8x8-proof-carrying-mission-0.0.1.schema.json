{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"8x8 Proof-Carrying Mission 0.0.1",
  "type":"object",
  "required":["mission_id","owner_intent","context_digest","agent_id","body_id","node_id","lease_id","capabilities","targets","acceptance_tests","events","artifacts","cleanup","rollback","reality","final_status","receipt_digest"],
  "properties":{
    "product_version":{"const":"0.0.1"},
    "mission_id":{"type":"string"},
    "parent_mission_id":{"type":["string","null"]},
    "owner_intent":{"type":"string","minLength":1},
    "context_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "agent_id":{"type":"string"},
    "body_id":{"type":"string"},
    "node_id":{"type":"string"},
    "lease_id":{"type":"string"},
    "capabilities":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "targets":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "acceptance_tests":{"type":"array","minItems":1,"items":{"type":"object","required":["test_id","result","evidence_digest"],"properties":{"test_id":{"type":"string"},"result":{"enum":["PASS","FAIL","BLOCKED","NOT_RUN"]},"evidence_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
    "events":{"type":"array","items":{"type":"object","required":["event_id","timestamp","event_type","digest"],"properties":{"event_id":{"type":"string"},"timestamp":{"type":"string","format":"date-time"},"event_type":{"type":"string"},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
    "artifacts":{"type":"array","items":{"type":"object","required":["path","digest","classification"],"properties":{"path":{"type":"string"},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"classification":{"enum":["PRIVATE","PUBLIC_SAFE","SENSITIVE","QUARANTINED"]}}}},
    "cleanup":{"type":"object","required":["status","residuals"],"properties":{"status":{"enum":["PASS","PARTIAL","FAILED","NOT_REQUIRED"]},"residuals":{"type":"array","items":{"type":"string"}}}},
    "rollback":{"type":"object","required":["available","target"],"properties":{"available":{"type":"boolean"},"target":{"type":["string","null"]},"tested":{"type":"boolean"}}},
    "reality":{"enum":["PRIVATE_PAST","PUBLIC_PRESENT","FUTURE_LAB"]},
    "promotion_state":{"enum":["NONE","PROTECTED_BETA"]},
    "final_status":{"enum":["PASS","PARTIAL","BLOCKED","FAILED","SUPERSEDED","STALE"]},
    "receipt_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  },
  "additionalProperties":false
}
