{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"8x8 Agent Lease 0.0.1",
  "type":"object",
  "required":["lease_id","task_id","agent_id","node_id","scope","write_targets","issued_at","expires_at","heartbeat_at","expected_evidence","cleanup","rollback","state"],
  "properties":{
    "product_version":{"const":"0.0.1"},
    "lease_id":{"type":"string"},
    "task_id":{"type":"string"},
    "agent_id":{"type":"string"},
    "body_id":{"type":["string","null"]},
    "node_id":{"type":"string"},
    "scope":{"type":"string"},
    "write_targets":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "read_targets":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "issued_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "heartbeat_at":{"type":"string","format":"date-time"},
    "expected_evidence":{"type":"array","minItems":1,"items":{"type":"string"}},
    "cleanup":{"type":"string"},
    "rollback":{"type":"string"},
    "state":{"enum":["PROPOSED","ACTIVE","EXPIRED","REVOKED","CONFLICT","COMPLETED"]},
    "handoff_receipt":{"type":["string","null"]}
  },
  "additionalProperties":false
}
